# ==============================================================================
# DecisionForge AI - Environment Configuration Example
# ==============================================================================

# Application Environment (development, production)
ENVIRONMENT=development
PROJECT_NAME="DecisionForge AI"

# Database Connection URLs
# - Production PostgreSQL
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@db:5432/decisionforge
# - Local SQLite (alternative for light local execution)
# DATABASE_URL=sqlite+aiosqlite:///decisionforge.db

# Cache & Celery Redis Queue URL
REDIS_URL=redis://redis:6379/0

# Security & JWT Tokens
JWT_SECRET=super-secret-key-decision-forge-ai-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Cors allowed origins
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Configuration (OpenAI Model GPT-4o integration)
# In local development mode, this can remain "mock-key" to trigger safe mock fallbacks.
OPENAI_API_KEY=mock-key
